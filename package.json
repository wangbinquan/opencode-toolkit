{
  "name": "harness-toolkit",
  "version": "0.4.0",
  "description": "团队共享工具包：subagent 任务完成度审查与自动续跑。一仓两宿主——opencode 插件（tool.execute.after）与 Claude Code hook（SubagentStop）",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./claude/hook": "./src/claude/hook.mjs"
  },
  "bin": {
    "harness-toolkit-install": "./bin/install.mjs",
    "opencode-toolkit-install": "./bin/install.mjs"
  },
  "files": [
    "src",
    "bin",
    "agents",
    "skills",
    "README.md"
  ],
  "engines": {
    "opencode": ">=0.1.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode-ai/sdk": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangbinquan/harness-toolkit.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-agent",
    "subagent",
    "task-completion"
  ],
  "license": "MIT"
}
